# Firebase config for KontrakKu (Vite env vars)
# Copy to .env.local for local dev, or set these in Vercel (Project Settings -> Environment Variables).
# These values are PUBLIC client config (not secrets) — but NEVER put debug tokens,
# service-account keys, or API keys for other services in this file or in the repo.
# Get the values from Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key (public) for Firebase App Check.
# Register a v3 site at https://www.google.com/recaptcha/admin, then register the
# app in Firebase console -> Security -> App Check with the SECRET key (secret key
# goes ONLY in the console, never here, never in the repo).
VITE_RECAPTCHA_SITE_KEY=
